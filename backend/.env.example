# Copy to .env and adjust. Never commit .env.

# Server
PORT=3001
CORS_ORIGIN=http://localhost:3000
# NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=advent

# Schema: off unless explicitly true. Prefer `npm run migration:run`.
# DB_SYNCHRONIZE=true

# Media files (paths relative to process cwd)
MEDIA_STORAGE_ROOT=uploads/media
MEDIA_PUBLIC_BASE_URL=http://localhost:3001
# APP_PUBLIC_URL=http://localhost:3001
# MEDIA_MAX_FILE_BYTES=15728640

# Auth (Leobit Identity / OIDC)
AUTH_ISSUER=https://test.identity.leobit.co
# AUTH_AUDIENCE=leobit.quest.web
AUTH_ROLE_CLAIM=role,Role,roles
AUTH_PRIVILEGED_ROLES=HR
# Local JWT bypass — blocked when NODE_ENV=production
# AUTH_DISABLED=true
