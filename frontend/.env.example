# Well Being Quest — environment example
#
# Copy this file to .env.local (gitignored) and adjust.
# Vite also loads `.env` if present; `.env.local` overrides `.env`.
#
# All VITE_* variables are optional when VITE_DEV_MODE=true.

# ============================================================================
# DEVELOPMENT MODE (auth bypass)
# ============================================================================
#
# true  — mock auth as dev@leobit.com, no Identity Server
# false — OIDC (requires VITE_APP_AUTH_AUTHORITY and VITE_APP_AUTH_REDIRECT_URI)
#
VITE_DEV_MODE=true

# ============================================================================
# AUTHENTICATION (OIDC) — required when VITE_DEV_MODE=false
# ============================================================================

# Identity provider base URL
# VITE_APP_AUTH_AUTHORITY=https://test.identity.leobit.co

# Must match the Vite origin (vite.config.ts uses port 3000, strictPort)
# VITE_APP_AUTH_REDIRECT_URI=http://localhost:3000

# Default client id in code: leobit.quest.web
# VITE_APP_AUTH_CLIENT_ID=leobit.quest.web

# Minimal OIDC scopes. Add a custom API scope when it is registered in Identity.
# VITE_APP_AUTH_SCOPE=openid profile

# JWT / profile claim keys for roles (comma-separated). Default: role,Role,roles
# VITE_APP_AUTH_ROLE_CLAIM=role

# Roles that can manage quests. Must match backend AUTH_PRIVILEGED_ROLES.
# VITE_APP_AUTH_PRIVILEGED_ROLES=HR

# ============================================================================
# DATA SOURCE
# ============================================================================

# Google Sheets CSV export URL. Empty in DEV mode → /mock-quest-data.csv
# Format: https://docs.google.com/spreadsheets/d/SHEET_ID/export?format=csv
VITE_GOOGLE_SHEET_URL=

# Nest API (quest CRUD, media). Default in Vite DEV / VITE_DEV_MODE: http://localhost:3001
# Enable CORS_ORIGIN=http://localhost:3000 in backend/.env.
VITE_API_BASE_URL=http://localhost:3001

# ============================================================================
# NOTES
# ============================================================================
#
# - Restart `npm run dev` after changing env files.
# - Never commit .env or .env.local.
# - Pair with backend/ on port 3001 for API-backed quests.
# - See README.md and docs/AUTHENTICATION.md.
